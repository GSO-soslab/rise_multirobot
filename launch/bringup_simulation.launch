    <include file="$(find wamv_bringup)/launch/bringup_multirobot.launch"/>

    <include file="$(find mvp_localization_utilities)/launch/world_to_world_transform.launch">
        <arg name="parent_name" value="$(arg parent_name)"/>
        <arg name="child_name" value="$(arg child_name)"/>
    </include>

    <!--PCL Processing node-->
    <!-- <include file="$(find pcl_proc)/launch/filter.launch"/> -->

    <!--Costmap Node-->
    <!-- <include file="$(find pcl_proc)/launch/costmap.launch"/> -->

</launch>