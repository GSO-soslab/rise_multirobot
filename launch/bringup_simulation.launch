<?xml version="1.0"?>

<launch>

    <arg name="parent_name" default="wamv"/>
    <arg name="child_name" default="alpha_rise"/>

    <include file="$(find alpha_rise_bringup)/launch/bringup_simulation.launch"/>

    <!-- <include file="$(find msis_pcl)/launch/start_cpp.launch"/> -->

    <!-- <include file="$(find wamv_path_planner)/launch/costmap.launch"/> -->

